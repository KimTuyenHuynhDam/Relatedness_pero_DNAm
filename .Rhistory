# Step 1: Fit linear model to remove age effect from entropy
entropy_model <- lm(entropy ~ Age, data = entropy_DNAm_BW)
# Step 2: Get residuals = entropy adjusted for age
entropy_DNAm_BW <- entropy_DNAm_BW %>%
mutate(entropy_resid = resid(entropy_model))
# Step 3: Fit model of residual entropy ~ Relatedness
cor_stats <- cor.test(entropy_DNAm_BW$entropy_resid, entropy_DNAm_BW$Relatedness)
R_val <- round(cor_stats$estimate, 2)
p_val <- signif(cor_stats$p.value, 2)
# Step 4: Plot residual entropy vs. relatedness
ggplot(entropy_DNAm_BW, aes(x = Relatedness, y = entropy_resid)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = TRUE, color = "darkred", linetype = "dashed") +
annotate("text", x = min(entropy_DNAm_BW$Relatedness), y = max(entropy_DNAm_BW$entropy_resid),
label = paste0("R = ", R_val, ", p = ", p_val),
hjust = 0, size = 5, fontface = "italic") +
labs(
title = "Residual Entropy (adjusted for Age) vs Relatedness",
x = "Relatedness",
y = "Entropy (residuals after Age adjustment)"
) +
theme_minimal(base_size = 14)
